{
  "skillOverrides": {
    "seo-audit": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/scripts/harness-check.mjs\" --session-start",
            "timeout": 30,
            "statusMessage": "ハーネスを点検しています"
          }
        ]
      }
    ]
  }
}
