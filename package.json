{
  "name": "spotee",
  "version": "0.1.0",
  "description": "スポット共有サービス Spotee",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run db:up && concurrently --kill-others -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "db:up": "docker compose -f infra/dev/docker-compose.yml up -d --wait",
    "db:stop": "docker compose -f infra/dev/docker-compose.yml stop",
    "db:migrate": "npm run db:migrate --workspace=backend --",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:seed:sample": "npm run db:seed:sample --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "db:status": "npm run db:status --workspace=backend",
    "codegen": "npm run codegen --workspace=frontend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=backend"
  },
  "keywords": [
    "nextjs",
    "nestjs",
    "graphql",
    "prisma",
    "supabase"
  ],
  "author": "Jo",
  "license": "MIT",
  "dependencies": {
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
